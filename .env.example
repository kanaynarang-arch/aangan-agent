# Copy to .env and fill in. Never commit .env.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Gemini API key (scoring)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Vani (voice agent)
VANI_API_KEY=
VANI_AGENT_ID=
VANI_WEBHOOK_SECRET=

# Telegram bot (from @BotFather) and the designers' chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# HubSpot service key (scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write)
HUBSPOT_TOKEN=

# Cal.com API key and the consultation event type id
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Public URL of the deployed app (used in Telegram links)
APP_URL=

# Feature flags
# Real calls only reach HubSpot / Telegram / Cal.com when this is "true".
LIVE_INTEGRATIONS=false
# Vani web (WebRTC) test calls are stored as test data unless this is "true".
TREAT_WEB_CALLS_AS_LIVE=false

# Cost config (rupees per minute of voice, rupees per US dollar)
VOICE_RATE_INR_PER_MIN=5.5
USD_TO_INR=90
