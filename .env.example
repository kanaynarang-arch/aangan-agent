# Copy to .env and fill in. Never commit .env.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Gemini API key (scoring)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Vani (voice agent)
VANI_API_KEY=
VANI_AGENT_ID=
VANI_WEBHOOK_SECRET=

# Telegram bot (from @BotFather) and the designers' chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# HubSpot service key (scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write)
HUBSPOT_TOKEN=

# Cal.com API key and the consultation event type id
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Public URL of the deployed app (used in Telegram links)
APP_URL=

# Feature flags
# Real calls only reach HubSpot / Telegram / Cal.com when this is "true".
LIVE_INTEGRATIONS=false
# Vani web (WebRTC) test calls are stored as test data unless this is "true".
TREAT_WEB_CALLS_AS_LIVE=false

# Cost config (rupees per minute of voice, rupees per US dollar)
VOICE_RATE_INR_PER_MIN=5.6
USD_TO_INR=90

# "Have Vani call back" on the call page. By default Vani talks to you in the browser (no phone number needed, nobody is rung).
# "true": live dropped calls are rung for real (test calls still rehearse in the browser). Vani can dial without a number of our own.
VANI_PHONE_CALLBACKS=false
# Ring back dropped calls by itself (needs VANI_PHONE_CALLBACKS=true). In hours at once, after hours in the 10am sweep. Off by default.
AUTO_CALLBACK_DROPPED=false
# Shared secret so only Vercel Cron can start the morning sweep.
CRON_SECRET=

# Cal.com checks that the attendee email can receive mail. Callers are never asked for one, so bookings use a plus-address of this
# (the studio's own email, e.g. studio@gmail.com becomes studio+lead-9000000101@gmail.com). Without it, bookings are refused.
CALCOM_ATTENDEE_EMAIL=
